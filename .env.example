# Copy to .env and adjust. The .env file is git-ignored.

# Verbose logging (DEBUG level). Set to false for INFO only.
DEBUG=true

# adb server that the adbutils client connects to.
# From inside Docker, point at the host: ADB_HOST=host.docker.internal or 127.0.0.1 if local
ADB_HOST=127.0.0.1
ADB_PORT=5037

# Optional: target a specific device/emulator. Required when several are attached
# (otherwise device resolution fails fast).
# ANDROID_SERIAL=emulator-5554
